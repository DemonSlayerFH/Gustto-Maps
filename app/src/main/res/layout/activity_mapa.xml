<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/burgundy" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Gustto · Mapa" android:textSize="24sp" android:textColor="@color/paper"
            android:textStyle="bold" />
        <TextView android:id="@+id/mapa_subtitulo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ubicaciones de restaurantes de demostración"
            android:textSize="13sp" android:textColor="@color/paper" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout android:id="@+id/mapa_host" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ScrollView android:id="@+id/mapa_sin_clave" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Para mostrar Google Maps real, agrega MAPS_API_KEY en local.properties. Mientras tanto, puedes probar los restaurantes de ejemplo:"
                    android:textColor="@color/ink" android:textSize="16sp" android:paddingBottom="14dp" />
                <LinearLayout android:id="@+id/lista_marcadores" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <Button android:id="@+id/mapa_volver" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="12dp" android:text="Volver"
        android:textAllCaps="false" />
</LinearLayout>
